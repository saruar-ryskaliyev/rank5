<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rank5" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rank5_background</item>
    </style>

    <!-- Cold-start splash: brand mark on the app background, then hands off to Theme.Rank5. -->
    <style name="Theme.Rank5.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rank5_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/rank5_brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Rank5</item>
    </style>
</resources>
