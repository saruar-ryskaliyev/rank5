# Copy this file to .env.local for local development.
# Never commit production credentials.
DATABASE_URL=postgres://rank5:rank5@127.0.0.1:5433/rank5?sslmode=disable
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
DEV_FAKE_AUTH=1

# AI deck generation. The generic OpenAI-compatible driver works with
# OpenRouter, LiteLLM, OpenAI, and compatible local gateways.
LLM_ENABLED=false
LLM_DRIVER=openai_compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-a-server-side-api-key
LLM_MODEL=your-model-id
LLM_TIMEOUT_SECONDS=35
LLM_MAX_OUTPUT_TOKENS=3000
LLM_USER_DAILY_LIMIT=5
LLM_GLOBAL_DAILY_LIMIT=150
# Optional spend guards. Cloudflare direct mode defaults to an 8,000-neuron
# daily budget, leaving headroom below its 10,000-neuron free allocation.
LLM_GLOBAL_DAILY_PROVIDER_UNIT_LIMIT=0
LLM_GLOBAL_DAILY_COST_USD_LIMIT=0
# Optional usage estimates for providers that return token counts.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0

# Cloudflare's direct Workers AI endpoint is also supported. When LLM_DRIVER,
# LLM_API_KEY, and LLM_MODEL are omitted, these variables are auto-detected.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# Recommended quality/cost default:
# CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
# Premium manual fallback (higher output-token cost):
# CLOUDFLARE_AI_MODEL=@cf/moonshotai/kimi-k2.6
